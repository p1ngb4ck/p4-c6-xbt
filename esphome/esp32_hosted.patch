+static constexpr uint32_t FLASH_BLOCK = 0x400;
+static constexpr uint32_t CHECKSUM_START = 0xEF;
+static constexpr uint32_t FLASH_LIMIT = 16u * 1024u * 1024u;
+static constexpr uint32_t FLASH_ERASE_BLOCK = 64u * 1024u;
