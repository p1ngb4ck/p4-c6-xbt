+  auto *self = static_cast<Esp32HostedUpdate *>(arg);
+  self->serial_.read_log(self->log_stop_);
+  self->serial_.close();
+  self->log_parked_.store(true, std::memory_order_release);
+  self->defer([self]() { self->serial_log_parked_(); });
